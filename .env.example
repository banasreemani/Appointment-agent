# Copy these placeholders into your environment. Do not put real secrets here.
GOOGLE_CALENDAR_ID="your-calendar-id@group.calendar.google.com"
GOOGLE_SERVICE_ACCOUNT_FILE="C:/absolute/path/to/service-account.json"
CLINIC_TIMEZONE="Asia/Kolkata"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
LLM_API_KEY="your_gemini_api_key_here"
LLM_MODEL="gemini-3.6-flash"
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USERNAME="your_sender_email@gmail.com"
EMAIL_SMTP_PASSWORD="your_gmail_app_password_here"
EMAIL_FROM_ADDRESS="your_sender_email@gmail.com"
